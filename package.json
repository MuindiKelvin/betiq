{
  "name": "betiq",
  "private": true,
  "version": "0.6.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "preview": "vite preview",
    "probe": "node --env-file=.env scripts/probe.mjs",
    "sync": "node scripts/sync.mjs",
    "sync:local": "node --env-file=.env scripts/sync.mjs",
    "sync:window": "node --env-file=.env scripts/sync.mjs",
    "sync:requests": "node --env-file=.env scripts/sync.mjs --requests-only",
    "sync:dry": "DRY_RUN=1 node --env-file=.env scripts/sync.mjs",
    "test": "node scripts/dev/test-model.mjs && node scripts/dev/test-bsd.mjs && node scripts/dev/test-value.mjs && node scripts/dev/test-live.mjs && node scripts/dev/test-board.mjs && node scripts/dev/test-secrets.mjs && node scripts/dev/test-requests.mjs && node scripts/dev/test-daily.mjs && node scripts/dev/test-grouping.mjs && node scripts/dev/test-receipts.mjs && node scripts/dev/test-receipt-preview.mjs && node scripts/dev/test-keys.mjs && node scripts/dev/test-route.mjs && node scripts/dev/test-rules-contract.mjs",
    "live": "node scripts/live.mjs",
    "live:local": "node --env-file=.env scripts/live.mjs",
    "probe:live": "node --env-file=.env scripts/probe-live.mjs",
    "test:live-run": "node scripts/dev/test-live-run.mjs",
    "test:requests-run": "node scripts/dev/test-requests-run.mjs",
    "test:e2e": "node scripts/dev/test-live-run.mjs && node scripts/dev/test-requests-run.mjs",
    "check:secrets": "node scripts/check-secrets.mjs",
    "verify": "npm run check:secrets && npm test && npm run test:e2e && npm run build",
    "start": "node scripts/daemon.mjs",
    "schedule": "node scripts/schedule.mjs",
    "schedule:local": "node --env-file=.env scripts/schedule.mjs",
    "picks": "node scripts/picks.mjs",
    "picks:local": "node --env-file=.env scripts/picks.mjs",
    "picks:why": "node --env-file=.env scripts/picks.mjs --why"
  },
  "dependencies": {
    "bootstrap": "^5.3.3",
    "bootstrap-icons": "^1.11.3",
    "firebase": "^10.14.1",
    "react": "^18.3.1",
    "react-bootstrap": "^2.10.5",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "^4.3.3",
    "firebase-admin": "^12.7.0",
    "vite": "^5.4.10"
  }
}
