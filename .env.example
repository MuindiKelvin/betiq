# Firebase web app values (Project settings > General > Your apps)
VITE_FB_API_KEY=
VITE_FB_AUTH_DOMAIN=
VITE_FB_PROJECT_ID=
VITE_FB_APP_ID=

# Bzzoiro Sports Data (free key: https://sports.bzzoiro.com/register/). Used only by scripts/, never shipped to the browser.
BSD_API_KEY=

# Optional live runner tuning (npm run live:local): LIVE_POLL_SECONDS=30  LIVE_RESERVE=1000  LIVE_LEAD_MINUTES=10  CHANGES_EVERY_MINUTES=5

# Optional sync tuning (defaults shown). The free tier allows 7,500 calls per day.
# SYNC_LEAGUES=all            or competition ids, e.g. 1,3,4,5,6 (see https://sports.bzzoiro.com/leagues/)
# SYNC_EXCLUDE=
# SEASONS_BACK=5              past seasons per competition (head-to-head depth)
# MAX_REQUESTS=6000           calls per run
# TEAMPACK_PER_RUN=400        teams per run whose squad + statistics are refreshed (3 calls each)
# MSTATS_PER_RUN=600          per-match statistics fetched per run
# PLAYERS_PER_RUN=100         player profiles preloaded per run (4 calls each)

# Scorers and assists (names), v0.6. One commentary call per finished match that had a goal; never spends the last GOALS_RESERVE calls of the day.
# GOALS_PER_COMP=25  GOALS_PER_RUN=300  GOALS_FROM_FINALS_PER_RUN=60  GOALS_RESERVE=1000
# Referee / venue / managers of the next fixtures, and managers + referees lists per competition
# INFO_UPCOMING=3  INFO_DETAIL_CALLS=0  INFO_PER_RUN=250  INFO_TTL_HOURS=24  VENUES_PER_RUN=100  VENUE_TTL_DAYS=30  REFEREES_PER_RUN=0  REFEREE_TTL_DAYS=7  PEOPLE_TTL_HOURS=24
# REQUESTS_PER_RUN=60          queued user requests served per sync run
# REQUESTS_PER_USER_DAY=100    per user, per UTC day (extra requests are dropped)
# REQUESTS_TOTAL_DAY=1000      all users, per UTC day (extra requests wait for the next day)
