rules_version = '2';
service cloud.firestore {
  match /databases/{db}/documents {
    // Synced data: signed-in users can read; nobody can write from the browser (only the sync script, via the admin key).
    match /{coll}/{id} {
      allow read: if request.auth != null
        && coll in ['catalog', 'index', 'meta', 'teams', 'seasons', 'fixtures', 'standings', 'leaders', 'transfers', 'squads', 'players', 'details', 'mstats', 'h2h'];
      allow write: if false;
    }
    // Requests queued from the app (match details, all-competition head-to-head, player profiles). The sync script fulfils and deletes them.
    match /requests/{id} {
      allow read: if request.auth != null;
      allow create: if request.auth != null
        && id.matches('^(d|h2h|p)_[0-9_]+$')
        && request.resource.data.keys().hasOnly(['kind', 'league', 'eid', 'h', 'a', 'pid', 'at'])
        && request.resource.data.kind in ['details', 'h2h', 'player']
        && request.resource.data.league is string
        && (!('eid' in request.resource.data) || request.resource.data.eid is int)
        && (!('h' in request.resource.data) || request.resource.data.h is int)
        && (!('a' in request.resource.data) || request.resource.data.a is int)
        && (!('pid' in request.resource.data) || request.resource.data.pid is int)
        && request.resource.data.at == request.time;
      allow update, delete: if false;
    }
    match /users/{uid}/picks/{id} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
